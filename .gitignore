# Dependencies
node_modules/

# Build output. Regenerate with: node build/build.js
dist/

# Scraped media, ~1.1 GB of images, PDFs and audio.
# Too large for the repo and fully reproducible: node build/pull.js
# The JSON manifests and Elementor HTML fallbacks beside it ARE committed,
# so the site can be rebuilt without going back to the live WordPress API.
_scrape/assets/

# Archives and one-off exports
*.zip

# Screenshot scratch from visual verification
.shots/
shot.py

# Mockups sent to the user, not part of the build
mockups/

# Editor media library: the originals, rebuilt with `npm run media`.
# DERIVED FOR NOW, so ignored. This must be committed before a client uses the
# editor for real: an image they upload lands here, and an uncommitted upload
# is an image that shows in the editor and never appears on the site.
# media-library/ is tracked through Git LFS (see .gitattributes). It has to
# be in the repo: it is where the editor writes what a client uploads, and
# the build copies from it.

# Secrets. Never commit.
.env
.env.*

# Local Netlify folder
.netlify
