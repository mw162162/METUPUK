# Hashed-by-path media never changes, so cache it hard.
/media/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800

# HTML should always revalidate so edits go live immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Search engines are allowed in. There is no X-Robots-Tag here, and that is
# deliberate rather than an omission — an earlier "/*  X-Robots-Tag: noindex"
# kept the preview out of the index while it lived under netlify.app, and would
# have taken the real site with it the day the domain moved.
#
# Nothing is lost by letting the preview be crawled: every page carries
# <link rel="canonical" href="https://metupuk.org.uk/..."> , so anything found
# here is attributed to the charity's own domain rather than competing with it.
#
# build/verify.js prints the state on every build, so if a noindex ever comes
# back it will say so.
