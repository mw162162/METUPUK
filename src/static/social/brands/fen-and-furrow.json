{
  "_comment": [
    "A second brand, invented, and here to prove two things.",
    "",
    "First: that the studio knows nothing about METUPUK. This file is written by",
    "hand where the other is generated, and shares no colour, no typeface, no",
    "mark and no hashtag with it. Fen & Furrow is not a real organisation.",
    "",
    "Second, and the reason it was extended: 'This week' is a template that does",
    "not exist anywhere in the code. It was written here, in JSON, out of the",
    "same seven blocks the others use — chip, heading, body, attribution — and",
    "it works. That is the whole claim of templates-as-data: the fifth customer",
    "wants a fifth template and gets one without a release."
  ],

  "schema": 1,
  "id": "fen-and-furrow",
  "name": "Fen & Furrow",
  "site": "fenandfurrow.example",

  "type": {
    "display": "\"Fraunces\",Georgia,\"Times New Roman\",serif",
    "body": "\"Hanken Grotesk\",-apple-system,\"Segoe UI\",sans-serif",
    "preload": [
      "900 100px Fraunces",
      "700 60px Fraunces",
      "600 30px Hanken Grotesk",
      "400 40px Hanken Grotesk"
    ],
    "webfonts": "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
  },

  "colour": {
    "figure": "#e9b949",
    "rule": "#c98a2e",
    "heading": "#fdfbf4",
    "soft": "#dfe7d5",
    "tag": "#e9b949",
    "chip": "#3f6b45",
    "signature": "#fdfbf4"
  },

  "grounds": [
    { "key": "field", "label": "Field", "from": "#1f3324", "to": "#2f4a33" },
    { "key": "furrow", "label": "Furrow", "from": "#14211a", "to": "#1f3324" },
    { "key": "harvest", "label": "Harvest", "from": "#5c4218", "to": "#2f4a33" }
  ],

  "mark": { "wordmark": "FEN & FURROW" },
  "duotone": "grayscale(1) contrast(1.05) sepia(1) hue-rotate(58deg) saturate(1.4) brightness(0.95)",
  "tags": ["#GrownHere", "#FenAndFurrow", "#EatTheSeason"],
  "libraries": {},

  "templates": [
    {
      "key": "figure",
      "label": "The number",
      "stem": "number",
      "start": { "story": 0.24, "wide": 0.1, "other": 0.13 },
      "fields": [
        { "name": "number", "label": "Number" },
        { "name": "headline", "label": "Sentence", "type": "textarea" },
        { "name": "note", "label": "Smaller line", "type": "textarea" }
      ],
      "blocks": [
        { "type": "figure", "from": "number", "colour": "figure", "take": 0.42 },
        { "type": "rule", "colour": "rule" },
        { "type": "heading", "from": "headline", "colour": "heading", "take": 0.66 },
        { "type": "body", "from": "note", "colour": "soft" }
      ],
      "caption": "{number} {headline} {note}",
      "alt": "The number {number} set large, over the words: {headline}.",
      "defaults": {
        "number": "1,400",
        "headline": "meals grown and given away from half an acre this year",
        "note": "Every one of them within three miles of where it was picked."
      }
    },
    {
      "key": "quote",
      "label": "What people say",
      "stem": "key",
      "start": { "story": 0.22, "wide": 0.1, "other": 0.14 },
      "fields": [
        { "name": "quote", "label": "Quote", "type": "textarea" },
        { "name": "who", "label": "Who said it" }
      ],
      "blocks": [
        { "type": "quoteMark", "colour": "rule" },
        { "type": "heading", "from": "quote", "colour": "heading", "size": 84, "min": 26, "weight": "700", "lh": 1.2, "take": 0.8, "after": 32 },
        { "type": "attribution", "from": "who", "colour": "figure" }
      ],
      "caption": "“{quote}” — {who}",
      "alt": "A quotation set large: “{quote}”, {who}.",
      "defaults": {
        "quote": "I came for the vegetables and stayed for the company.",
        "who": "Maureen, Tuesday volunteer"
      }
    },
    {
      "key": "session",
      "label": "This week",
      "stem": "what",
      "start": { "story": 0.26, "wide": 0.12, "other": 0.16 },
      "fields": [
        { "name": "day", "label": "Day" },
        { "name": "what", "label": "What is on" },
        { "name": "where", "label": "Where", "type": "textarea" },
        { "name": "time", "label": "Time" }
      ],
      "blocks": [
        { "type": "chip", "from": "day", "colour": "chip" },
        { "type": "heading", "from": "what", "colour": "heading", "size": 140, "min": 42, "lh": 1.02, "take": 0.55, "after": 18 },
        { "type": "body", "from": "where", "colour": "soft", "size": 42, "weight": "600", "lh": 1.3, "take": 0.6, "after": 14 },
        { "type": "attribution", "from": "time", "colour": "figure", "size": 34 }
      ],
      "caption": "{day} · {what} · {where} · {time}",
      "alt": "A notice: {what}, {where}, {day} at {time}.",
      "defaults": {
        "day": "Every Tuesday",
        "what": "Growing morning",
        "where": "The walled garden, Fen Lane",
        "time": "10am until 1pm · no experience needed"
      }
    }
  ]
}
